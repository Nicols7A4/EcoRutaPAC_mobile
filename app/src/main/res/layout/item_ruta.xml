<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabecera de la card: Código y Badge de Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCodigo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RUTA-2026-001"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvEstadoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN CURSO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/status_en_curso"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Información de Fecha y Turno -->
        <TextView
            android:id="@+id/tvFechaTurno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fecha: 2026-11-05 | Turno: Mañana"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <!-- Operario y Vehículo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOperario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Operario: Carlos Pérez"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvVehiculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehículo: M3K-842"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Progreso y Porcentaje de Avance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/pbAvance"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:progress="50"
                android:max="100"
                android:progressTint="@color/primary" />

            <TextView
                android:id="@+id/tvPuntosAvance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="2/4 (50%)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
